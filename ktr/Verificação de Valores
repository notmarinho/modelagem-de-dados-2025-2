#DimTempo

SELECT
    COUNT(*) AS Total_Registros,
    SUM(CASE WHEN Data_Completa IS NULL THEN 1 ELSE 0 END) AS Nulos_Data_Completa,
    SUM(CASE WHEN Ano IS NULL THEN 1 ELSE 0 END) AS Nulos_Ano,
    SUM(CASE WHEN Nome_Mes IS NULL THEN 1 ELSE 0 END) AS Nulos_Nome_Mes,
    SUM(CASE WHEN Dia_da_Semana IS NULL THEN 1 ELSE 0 END) AS Nulos_Dia_da_Semana,
    SUM(CASE WHEN Hora_do_Dia IS NULL THEN 1 ELSE 0 END) AS Nulos_Hora_do_Dia
FROM DimTempo;



